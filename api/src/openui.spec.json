{
  "root": "Stack",
  "components": {
    "Stack": {
      "signature": "Stack(children: (Text | Heading | Link | FollowUp | Chart | Map | Invoice | Card)[])",
      "description": "The root vertical layout, containing at most 24 basic components or cards. Do not nest stacks."
    },
    "Card": {
      "signature": "Card(children: (Text | Heading | Link | FollowUp | Chart | Map | Invoice)[])",
      "description": "A card for a discrete item, containing at most 24 basic components. Do not nest cards or stacks."
    },
    "Heading": {
      "signature": "Heading(text: string, level?: 2 | 3 | 4)",
      "description": "A section heading; level is 2, 3, or 4."
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "A plain-text paragraph. No HTML or Markdown."
    },
    "Link": {
      "signature": "Link(label: string, url: string)",
      "description": "A descriptive link to an HTTP(S) source, without credentials."
    },
    "FollowUp": {
      "signature": "FollowUp(label: string, message: string)",
      "description": "An optional button that sends its message as a user follow-up when clicked. No other actions."
    },
    "Chart": {
      "signature": "Chart(title: string, type: \"line\" | \"bar\", xLabel: string, yLabel: string, labels: string[], series: {name: string, values: number[]}[] | {name: string, values: number[]})",
      "description": "A line or bar chart of real data. Include axis labels and units. Supply 1–100 labels and an array of 1–4 named series (a single series object is also accepted). Use null for missing data; omitted trailing values appear as gaps."
    },
    "Map": {
      "signature": "Map(title: string, unit: string, cantons: {code: \"AG\" | \"AI\" | \"AR\" | \"BE\" | \"BL\" | \"BS\" | \"FR\" | \"GE\" | \"GL\" | \"GR\" | \"JU\" | \"LU\" | \"NE\" | \"NW\" | \"OW\" | \"SG\" | \"SH\" | \"SO\" | \"SZ\" | \"TG\" | \"TI\" | \"UR\" | \"VD\" | \"VS\" | \"ZG\" | \"ZH\", label: string, value?: number}[], markers: {label: string, longitude: number, latitude: number}[])",
      "description": "A Swiss canton map with optional numeric canton shading and labeled location markers. Supply up to 26 unique two-letter canton codes and 20 markers. Coordinates are WGS84 longitude/latitude within Switzerland's bounding box. Use null for missing canton values; pass empty arrays for unused layers. Boundaries are generalized historical outlines, not current administrative or navigation data."
    },
    "Invoice": {
      "signature": "Invoice(title: string, amount: number, currency: \"CHF\" | \"EUR\", creditor: {name: string, address: string, buildingNumber: string, zip: string, city: string, country: string, account: string}, debtor: {name: string, address: string, buildingNumber: string, zip: string, city: string, country: string}, reference: string, message: string, language: \"DE\" | \"EN\" | \"FR\" | \"IT\" | \"RM\")",
      "description": "A Swiss QR invoice with payment-slip preview and a user-triggered PDF download. Use only billing details supplied or confirmed by the user. Requires title, amount, CHF/EUR, creditor with CH/LI IBAN, debtor, reference (empty if unused), message (empty if unused), and DE/EN/FR/IT/RM language. Addresses are structured: name, street address, buildingNumber (empty if absent), zip, city, two-letter country. Invalid IBANs and incompatible references are rejected. Does not send an invoice or execute a payment."
    }
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "Stack": {
        "$ref": "#/$defs/Stack"
      },
      "Card": {
        "$ref": "#/$defs/Card"
      },
      "Heading": {
        "$ref": "#/$defs/Heading"
      },
      "Text": {
        "$ref": "#/$defs/Text"
      },
      "Link": {
        "$ref": "#/$defs/Link"
      },
      "FollowUp": {
        "$ref": "#/$defs/FollowUp"
      },
      "Chart": {
        "$ref": "#/$defs/Chart"
      },
      "Map": {
        "$ref": "#/$defs/Map"
      },
      "Invoice": {
        "$ref": "#/$defs/Invoice"
      }
    },
    "required": [
      "Stack",
      "Card",
      "Heading",
      "Text",
      "Link",
      "FollowUp",
      "Chart",
      "Map",
      "Invoice"
    ],
    "additionalProperties": false,
    "$defs": {
      "Stack": {
        "type": "object",
        "properties": {
          "children": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Heading"
                },
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "$ref": "#/$defs/FollowUp"
                },
                {
                  "$ref": "#/$defs/Chart"
                },
                {
                  "$ref": "#/$defs/Map"
                },
                {
                  "$ref": "#/$defs/Invoice"
                },
                {
                  "$ref": "#/$defs/Card"
                }
              ]
            }
          }
        },
        "required": [
          "children"
        ],
        "additionalProperties": false,
        "description": "The root vertical layout, containing at most 24 basic components or cards. Do not nest stacks."
      },
      "Text": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "A plain-text paragraph. No HTML or Markdown."
      },
      "Heading": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "level": {
            "default": 2,
            "anyOf": [
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              }
            ]
          }
        },
        "required": [
          "text",
          "level"
        ],
        "additionalProperties": false,
        "description": "A section heading; level is 2, 3, or 4."
      },
      "Link": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false,
        "description": "A descriptive link to an HTTP(S) source, without credentials."
      },
      "FollowUp": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "label",
          "message"
        ],
        "additionalProperties": false,
        "description": "An optional button that sends its message as a user follow-up when clicked. No other actions."
      },
      "Chart": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "line",
              "bar"
            ]
          },
          "xLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "yLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "labels": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "series": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "values": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "required": [
                    "name",
                    "values"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "values": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "values"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "title",
          "type",
          "xLabel",
          "yLabel",
          "labels",
          "series"
        ],
        "additionalProperties": false,
        "description": "A line or bar chart of real data. Include axis labels and units. Supply 1–100 labels and an array of 1–4 named series (a single series object is also accepted). Use null for missing data; omitted trailing values appear as gaps."
      },
      "Map": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit": {
            "type": "string",
            "maxLength": 100
          },
          "cantons": {
            "maxItems": 26,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "AG",
                    "AI",
                    "AR",
                    "BE",
                    "BL",
                    "BS",
                    "FR",
                    "GE",
                    "GL",
                    "GR",
                    "JU",
                    "LU",
                    "NE",
                    "NW",
                    "OW",
                    "SG",
                    "SH",
                    "SO",
                    "SZ",
                    "TG",
                    "TI",
                    "UR",
                    "VD",
                    "VS",
                    "ZG",
                    "ZH"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "code",
                "label",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "markers": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "longitude": {
                  "type": "number",
                  "minimum": 5.9,
                  "maximum": 10.6
                },
                "latitude": {
                  "type": "number",
                  "minimum": 45.8,
                  "maximum": 47.9
                }
              },
              "required": [
                "label",
                "longitude",
                "latitude"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "unit",
          "cantons",
          "markers"
        ],
        "additionalProperties": false,
        "description": "A Swiss canton map with optional numeric canton shading and labeled location markers. Supply up to 26 unique two-letter canton codes and 20 markers. Coordinates are WGS84 longitude/latitude within Switzerland's bounding box. Use null for missing canton values; pass empty arrays for unused layers. Boundaries are generalized historical outlines, not current administrative or navigation data."
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 999999999.99,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "CHF",
              "EUR"
            ]
          },
          "creditor": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
              },
              "address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
              },
              "buildingNumber": {
                "type": "string",
                "maxLength": 16
              },
              "zip": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 35
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "account": {
                "type": "string",
                "minLength": 21,
                "maxLength": 34
              }
            },
            "required": [
              "name",
              "address",
              "buildingNumber",
              "zip",
              "city",
              "country",
              "account"
            ],
            "additionalProperties": false
          },
          "debtor": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
              },
              "address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
              },
              "buildingNumber": {
                "type": "string",
                "maxLength": 16
              },
              "zip": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 35
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            },
            "required": [
              "name",
              "address",
              "buildingNumber",
              "zip",
              "city",
              "country"
            ],
            "additionalProperties": false
          },
          "reference": {
            "type": "string",
            "maxLength": 35
          },
          "message": {
            "type": "string",
            "maxLength": 140
          },
          "language": {
            "type": "string",
            "enum": [
              "DE",
              "EN",
              "FR",
              "IT",
              "RM"
            ]
          }
        },
        "required": [
          "title",
          "amount",
          "currency",
          "creditor",
          "debtor",
          "reference",
          "message",
          "language"
        ],
        "additionalProperties": false,
        "description": "A Swiss QR invoice with payment-slip preview and a user-triggered PDF download. Use only billing details supplied or confirmed by the user. Requires title, amount, CHF/EUR, creditor with CH/LI IBAN, debtor, reference (empty if unused), message (empty if unused), and DE/EN/FR/IT/RM language. Addresses are structured: name, street address, buildingNumber (empty if absent), zip, city, two-letter country. Invalid IBANs and incompatible references are rejected. Does not send an invoice or execute a payment."
      },
      "Card": {
        "type": "object",
        "properties": {
          "children": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Heading"
                },
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "$ref": "#/$defs/FollowUp"
                },
                {
                  "$ref": "#/$defs/Chart"
                },
                {
                  "$ref": "#/$defs/Map"
                },
                {
                  "$ref": "#/$defs/Invoice"
                }
              ]
            }
          }
        },
        "required": [
          "children"
        ],
        "additionalProperties": false,
        "description": "A card for a discrete item, containing at most 24 basic components. Do not nest cards or stacks."
      }
    }
  }
}
