{
  "root": "Stack",
  "components": {
    "Stack": {
      "signature": "Stack(children: (Text | Heading | Link | FollowUp | Chart | Card)[])",
      "description": "The root vertical layout, containing at most 24 basic components or cards. Do not nest stacks."
    },
    "Card": {
      "signature": "Card(children: (Text | Heading | Link | FollowUp | Chart)[])",
      "description": "A card for a discrete item, containing at most 24 basic components. Do not nest cards or stacks."
    },
    "Heading": {
      "signature": "Heading(text: string, level?: 2 | 3 | 4)",
      "description": "A section heading; level is 2, 3, or 4."
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "A plain-text paragraph. No HTML or Markdown."
    },
    "Link": {
      "signature": "Link(label: string, url: string)",
      "description": "A descriptive link to an HTTP(S) source, without credentials."
    },
    "FollowUp": {
      "signature": "FollowUp(label: string, message: string)",
      "description": "An optional button that sends its message as a user follow-up when clicked. No other actions."
    },
    "Chart": {
      "signature": "Chart(title: string, type: \"line\" | \"bar\", xLabel: string, yLabel: string, labels: string[], series: {name: string, values: number[]}[])",
      "description": "A line or bar chart of real data. Include axis labels and units. Supply 1–100 labels and 1–4 named series, each with one numeric value per label (null for missing data)."
    }
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "Stack": {
        "$ref": "#/$defs/Stack"
      },
      "Card": {
        "$ref": "#/$defs/Card"
      },
      "Heading": {
        "$ref": "#/$defs/Heading"
      },
      "Text": {
        "$ref": "#/$defs/Text"
      },
      "Link": {
        "$ref": "#/$defs/Link"
      },
      "FollowUp": {
        "$ref": "#/$defs/FollowUp"
      },
      "Chart": {
        "$ref": "#/$defs/Chart"
      }
    },
    "required": [
      "Stack",
      "Card",
      "Heading",
      "Text",
      "Link",
      "FollowUp",
      "Chart"
    ],
    "additionalProperties": false,
    "$defs": {
      "Stack": {
        "type": "object",
        "properties": {
          "children": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Heading"
                },
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "$ref": "#/$defs/FollowUp"
                },
                {
                  "$ref": "#/$defs/Chart"
                },
                {
                  "$ref": "#/$defs/Card"
                }
              ]
            }
          }
        },
        "required": [
          "children"
        ],
        "additionalProperties": false,
        "description": "The root vertical layout, containing at most 24 basic components or cards. Do not nest stacks."
      },
      "Text": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "A plain-text paragraph. No HTML or Markdown."
      },
      "Heading": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "level": {
            "default": 2,
            "anyOf": [
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              }
            ]
          }
        },
        "required": [
          "text",
          "level"
        ],
        "additionalProperties": false,
        "description": "A section heading; level is 2, 3, or 4."
      },
      "Link": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false,
        "description": "A descriptive link to an HTTP(S) source, without credentials."
      },
      "FollowUp": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "label",
          "message"
        ],
        "additionalProperties": false,
        "description": "An optional button that sends its message as a user follow-up when clicked. No other actions."
      },
      "Chart": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "line",
              "bar"
            ]
          },
          "xLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "yLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "labels": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "series": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "values": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "values"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "type",
          "xLabel",
          "yLabel",
          "labels",
          "series"
        ],
        "additionalProperties": false,
        "description": "A line or bar chart of real data. Include axis labels and units. Supply 1–100 labels and 1–4 named series, each with one numeric value per label (null for missing data)."
      },
      "Card": {
        "type": "object",
        "properties": {
          "children": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Heading"
                },
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "$ref": "#/$defs/FollowUp"
                },
                {
                  "$ref": "#/$defs/Chart"
                }
              ]
            }
          }
        },
        "required": [
          "children"
        ],
        "additionalProperties": false,
        "description": "A card for a discrete item, containing at most 24 basic components. Do not nest cards or stacks."
      }
    }
  }
}
